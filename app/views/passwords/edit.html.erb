<main class="signin">
  <div class="signin__lockup"><%= render "application/lockup", size: 24 %></div>

  <% if flash[:alert] %>
    <p class="signin__alert"><%= flash[:alert] %></p>
  <% end %>

  <h1 class="signin__title"><%= t("passwords.edit.title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <label class="signin__field">
      <span class="signin__label"><%= t("passwords.edit.password") %></span>
      <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            maxlength: 72,
            class: "signin__input" %>
    </label>

    <label class="signin__field">
      <span class="signin__label"><%= t("passwords.edit.confirmation") %></span>
      <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            maxlength: 72,
            class: "signin__input" %>
    </label>

    <%= form.submit t("passwords.edit.submit"), class: "signin__submit" %>
  <% end %>
</main>

<%# Fixed sample content, not the reader's own edition. The design handoff asks
    for a live one here; this page is unauthenticated, so that would publish
    real stories and sources to anyone who loads it. The frame, scale and
    caption bar are the handoff's; the hierarchy inside them is the edition
    page's, reduced.

    Nothing in here is a link. It is a picture made of markup, and a source
    that looked like one would promise a page a visitor cannot open. %>
<section class="landing__frame landing__shot">
  <div class="shot">
    <div class="shot__caption">
      <span><%= t("waitlist_signups.shot.caption") %></span>
      <span class="shot__subcaption"><%= t("waitlist_signups.shot.subcaption") %></span>
    </div>

    <div class="shot__body">
      <% t("waitlist_signups.shot.sections").each do |section| %>
        <p class="shot__group"><%= section[:heading] %></p>

        <% section[:stories].each do |story| %>
          <div class="shot__story">
            <% if story[:headline] %>
              <p class="shot__headline"><%= story[:headline] %></p>
            <% end %>

            <p class="shot__story-body"><%= story[:body] %></p>

            <p class="shot__sources">
              <span class="shot__sources-label">
                <%= t("waitlist_signups.shot.sources",
                      count: story[:sources].length) %>
              </span>

              <% story[:sources].each do |source| %>
                <span class="shot__source"><%= source %></span>
              <% end %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

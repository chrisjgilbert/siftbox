<%# The public page, in two states: `waitlist` names the partial that fills
    both form slots, so neither this template nor the slots carry a branch and
    the model needs no flag saying which state it is in. %>
<% content_for :indexable, true %>
<% content_for :title, t("waitlist_signups.new.page_title") %>

<div class="landing">
  <div class="landing__nav">
    <div class="landing__frame landing__nav-inner">
      <%= render "application/lockup", size: 24 %>
      <%= link_to t("waitlist_signups.nav.waitlist"), "#waitlist-hero",
            class: "landing__nav-link" %>
    </div>
  </div>

  <section class="landing__frame landing__hero">
    <p class="landing__eyebrow"><%= t("waitlist_signups.new.eyebrow") %></p>
    <h1 class="landing__title"><%= t("waitlist_signups.new.title") %></h1>
    <p class="landing__standfirst"><%= t("waitlist_signups.new.standfirst") %></p>

    <%= render waitlist, signup: signup, id: "waitlist-hero", inverted: false %>
  </section>

  <%= render "waitlist_signups/shot" %>

  <section class="landing__frame landing__points">
    <% [ "address", "feed" ].each do |point| %>
      <div class="point">
        <p class="point__kicker"><%= t("waitlist_signups.points.#{point}.kicker") %></p>
        <h2 class="point__title"><%= t("waitlist_signups.points.#{point}.title") %></h2>
        <p class="point__body"><%= t("waitlist_signups.points.#{point}.body") %></p>
      </div>
    <% end %>
  </section>

  <div class="closing">
    <div class="landing__frame closing__inner">
      <div>
        <h2 class="closing__title"><%= t("waitlist_signups.closing.title") %></h2>
        <p class="closing__body"><%= t("waitlist_signups.closing.body") %></p>
      </div>

      <%= render waitlist, signup: signup, id: "waitlist-band", inverted: true %>
    </div>
  </div>

  <footer class="landing__frame landing__footer">
    <span class="landing__footer-brand">
      <%= render "application/mark", size: 16 %>
      <span><%= t("waitlist_signups.footer.wordmark") %></span>
    </span>
    <span><%= t("waitlist_signups.footer.built") %></span>
  </footer>
</div>

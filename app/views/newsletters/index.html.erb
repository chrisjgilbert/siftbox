<header class="masthead">
  <div class="masthead__brand"><%= render "application/lockup", size: 24 %></div>

  <nav class="filters">
    <%= link_to t("newsletters.filters.everything"),
          newsletters_path,
          class: class_names("filters__link", "filters__link--active" => @feed.everything?) %>
    <%= link_to t("newsletters.filters.unread", count: @feed.unread_count),
          newsletters_path(filter: @feed.unread_filter),
          class: class_names("filters__link", "filters__link--active" => @feed.unread_only?) %>
  </nav>
</header>

<main class="feed">
  <% @feed.groups.each do |group| %>
    <section class="feed__group">
      <div class="feed__group-header">
        <h2 class="feed__group-label"><%= group.label %></h2>
        <span class="feed__group-sublabel"><%= group.sublabel %></span>
      </div>

      <% group.newsletters.each do |row| %>
        <%= render row.to_partial_path, row: row %>
      <% end %>
    </section>
  <% end %>

  <% if @feed.groups.any? %>
    <div class="feed__end">
      <p class="feed__end-line">
        <%= t("newsletters.index.end_of_feed", count: @feed.issue_count) %>
      </p>
      <p class="feed__end-line">
        <%= t("newsletters.index.subscribe", address: inbound_address) %>
      </p>
    </div>
  <% else %>
    <p class="feed__empty">
      <%= t("newsletters.index.empty", address: inbound_address) %>
    </p>
  <% end %>
</main>

<% content_for :title, @newsletter.subject %>

<%# Two bars, one page. Mail waiting in the pen is not in the archive and has
    nowhere to go back to, so it gets the pen's bar and the pen's two endings;
    everything else keeps the archive's. The moment a hold resolves the bar
    goes back to the archive's, which is what stops a page left open from
    posting a second, contradicting ending. %>
<% if @newsletter.held? %>
  <%= render "newsletters/originals/pen_bar", newsletter: @newsletter %>
<% else %>
  <%= render "newsletters/originals/archive_bar", newsletter: @newsletter %>
<% end %>

<main class="original">
  <p class="original__caption"><%= t("newsletters.original.caption") %></p>

  <%# No allow-scripts and no allow-same-origin: the frame gets an opaque
      origin and cannot reach the app's cookies or DOM. allow-popups and
      allow-popups-to-escape-sandbox are what make the sender's links work. %>
  <iframe class="original__frame"
          src="<%= newsletter_source_path(@newsletter) %>"
          sandbox="allow-popups allow-popups-to-escape-sandbox"
          referrerpolicy="no-referrer"
          loading="lazy"
          title="<%= @newsletter.subject %>"></iframe>
</main>

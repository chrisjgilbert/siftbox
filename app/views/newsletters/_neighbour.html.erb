<%= tag.div(class: class_names("neighbours__cell", class_name)) do %>
  <% if newsletter %>
    <%= link_to newsletter_path(newsletter), class: "neighbours__link" do %>
      <span class="neighbours__label">
        <span class="neighbours__direction"><%= label %></span>
        <span class="neighbours__sender"><%= newsletter.sender %></span>
      </span>
      <span class="neighbours__subject"><%= newsletter.subject %></span>
    <% end %>
  <% end %>
<% end %>

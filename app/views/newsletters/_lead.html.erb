<%# The newest item in the feed, when it has an image to lead with. Same
    fields as a standard row, at full frame width. %>
<%= link_to newsletter_original_path(row),
      class: class_names("lead", "lead--read" => row.read?) do %>
  <img class="lead__image" src="<%= row.lead_image_url %>" alt="" loading="lazy">

  <span class="lead__number"><%= row.number %></span>
  <span class="lead__sender"><%= row.sender %></span>
  <span class="lead__subject"><%= row.subject %></span>
  <span class="lead__snippet"><%= row.snippet %></span>
  <span class="lead__timestamp"><%= row.timestamp %></span>
<% end %>

<% content_for :title, @edition.masthead %>

<%# The number and the day covered, which is what an edition is called, and
    so is the page's own heading. %>
<%= render "application/masthead", line: @edition.masthead %>

<%# Between the masthead and the edition, because this is the page a reader
    opens every morning and a confirm link expires in a day or two. It stays
    until the mail is resolved. %>
<% if badge.pending? %>
  <%= render "application/badge", badge: badge %>
<% end %>

<main class="edition">
  <%# Above the first section, because a reader who came to listen rather than
      to read should not have to scroll past the lead to find the button. Inside
      the edition rather than in the band above it, because it is the edition
      and not chrome about it. %>
  <%= render "editions/recording", recording: @edition.recording %>

  <% @edition.sections.each do |section| %>
    <%= render "editions/section", section: section %>
  <% end %>
</main>

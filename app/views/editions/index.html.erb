<%= render "application/masthead", line: t(".line") %>

<%# The archive carries the notice for the same reason the edition does, and
    for one of its own: root serves this page on a morning before the first
    edition exists, which is exactly the morning a reader is subscribing to
    things. %>
<% if badge.pending? %>
  <%= render "application/badge", badge: badge %>
<% end %>

<main class="archive">
  <% if @archive.any? %>
    <%# What the list holds and which way it runs. The order is stated because
        it is the one thing about this page a reader could get wrong: the
        numbers can read No. 1, No. 3, No. 2 where an edition was composed
        late for an earlier day, and the day covered is what it sorts by. %>
    <div class="archive__caption">
      <span class="archive__count"><%= t(".count", count: @archive.count) %></span>
      <span class="archive__order"><%= t(".order") %></span>
    </div>

    <%# Editions and the mornings composition failed on, in one list. Each row
        picks its own template, so no template asks which kind it is holding —
        the same way the Subscriptions page draws its three. %>
    <ol class="archive__list"><%= render @archive.rows %></ol>
  <% else %>
    <p class="archive__empty"><%= t(".empty") %></p>
  <% end %>
</main>

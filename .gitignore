# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
#   `~/.gitignore_global`

# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets compiled by Propshaft.
/public/assets

# The app carries no encrypted credentials any more, so nothing needs this
# key. An older clone may still hold one, and it must never be committed.
/config/master.key

# The per-environment keys Rails writes if anyone runs credentials:edit out of
# habit. Nothing here reads credentials, so there should never be one — which
# is the reason to keep this rather than to drop it: no other line would stop
# such a file being committed, and a Rails key is thirty-two hex characters
# with no prefix, so secret scanning has nothing to match on. The two .enc
# lines that used to sit here are gone; an encrypted file without its key
# gives nothing away.
/config/credentials/*.key

# Ignore the raw deploy secrets. /.kamal/secrets itself is safe for git and
# stays committed; this is the file that holds actual values.
/.kamal/secrets-common

# Ignore the per-destination secrets files, which hold values the same way
# secrets-common does. Kamal reads .kamal/secrets.production for a deploy with
# -d production, and there is no committed file by that name to shadow.
/.kamal/secrets.*

# Ignore the destination files that name one deployment. config/deploy.yml is
# the committed template; config/deploy.production.yml carries the host, the
# registry account and the values that belong to one machine, and Kamal merges
# it over the template for -d production.
/config/deploy.*.yml

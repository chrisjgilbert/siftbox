# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
#   `~/.gitignore_global`

# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets compiled by Propshaft.
/public/assets

# The app carries no encrypted credentials any more, so nothing needs this
# key. An older clone may still hold one, and it must never be committed.
/config/master.key

# Both halves of the credentials pair Rails writes if anyone runs
# credentials:edit out of habit — for different reasons, which is why neither
# line can go without the other.
#
# A key must never be committed and nothing else here would stop one: a Rails
# key is thirty-two hex characters with no prefix, so secret scanning has
# nothing to match on.
#
# An encrypted file gives nothing away without its key, but committing one is
# its own mess: the contributor who wrote it holds the only key, so it is a
# file nobody else can ever open, and it takes precedence over nothing —
# credentials:edit reads it, fails to decrypt it, and the next person to run
# that command gets the error rather than an editor. Nothing here reads
# credentials at all, so there should never be either file.
/config/credentials.yml.enc
/config/credentials/*.key
/config/credentials/*.yml.enc

# Ignore the raw deploy secrets. /.kamal/secrets itself is safe for git and
# stays committed; this is the file that holds actual values.
/.kamal/secrets-common

# Ignore the per-destination secrets files. These hold values the way
# secrets-common does; .kamal/secrets itself assigns nothing and stays
# committed.
/.kamal/secrets.*

# Ignore the destination files. config/deploy.yml is the committed template;
# config/deploy.production.yml is the one that names a host, a registry account
# and one machine's values.
/config/deploy.*.yml
